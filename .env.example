# LLM Gateway Configuration
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: model name (defaults to @makers/deepseek-v4-flash)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ── Local Embeddings (free, offline, no API key required) ────────────────────
# Embedding backend for the Chroma vector store. "local" uses fastembed with a
# multilingual model downloaded once and cached — no external service, no cost.
EMBED_PROVIDER=local

# Lightweight multilingual model (~470 MB): handles zh + id + en well and runs
# on a standard laptop CPU. Swap for "intfloat/multilingual-e5-large" if you want
# higher quality (heavier download) or another fastembed-supported model.
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional chunking tuning
RAG_CHUNK_TOKENS=500
RAG_OVERLAP_TOKENS=50
